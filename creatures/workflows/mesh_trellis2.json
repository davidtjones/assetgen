{
  "1": {"class_type": "LoadImage", "_meta": {"title": "concept"},
        "inputs": {"image": "{{image}}"}},
  "2": {"class_type": "LoadBackgroundRemovalModel", "inputs": {"bg_removal_name": "birefnet.safetensors"}},
  "3": {"class_type": "RemoveBackground", "inputs": {"bg_removal_model": ["2", 0], "image": ["1", 0]}},
  "4": {"class_type": "ImageCropToMask", "_meta": {"title": "cut-out, centred"},
        "inputs": {"images": ["1", 0], "masks": ["3", 0], "width": 1024, "height": 1024,
                   "pad_factor": "{{pad}}", "grow_mask": 0, "background": "#000000"}},
  "5": {"class_type": "SaveImage", "inputs": {"images": ["4", 0], "filename_prefix": "{{prefix_cutout}}"}},

  "10": {"class_type": "CLIPVisionLoader", "inputs": {"clip_name": "dino_v3_vit_l.safetensors"}},
  "11": {"class_type": "Trellis2Conditioning", "inputs": {"clip_vision_model": ["10", 0], "image": ["4", 0]}},
  "12": {"class_type": "UNETLoader", "inputs": {"unet_name": "{{unet}}", "weight_dtype": "default"}},
  "13": {"class_type": "VAELoader", "inputs": {"vae_name": "trellis_2_shape_vae_bf16.safetensors"}},
  "14": {"class_type": "VAELoader", "inputs": {"vae_name": "trellis_2_texture_vae_bf16.safetensors"}},

  "_comment_cfg": "CFGOverride and RescaleCFG reproduce the reference pipeline's guidance interval and rescale (as in Comfy's own template).",
  "20": {"class_type": "CFGOverride", "inputs": {"model": ["12", 0], "cfg": 1.0, "start_percent": 0.667, "end_percent": 1.0}},
  "21": {"class_type": "RescaleCFG", "inputs": {"model": ["20", 0], "multiplier": 0.7}},
  "22": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["21", 0], "shift": 5.0}},
  "23": {"class_type": "EmptyTrellis2LatentStructure", "inputs": {"batch_size": 1}},
  "24": {"class_type": "KSampler", "_meta": {"title": "structure"},
         "inputs": {"model": ["22", 0], "positive": ["11", 0], "negative": ["11", 1], "latent_image": ["23", 0],
                    "seed": "{{seed}}", "steps": 12, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0}},
  "25": {"class_type": "VaeDecodeStructureTrellis2", "inputs": {"samples": ["24", 0], "vae": ["13", 0], "resolution": "32"}},

  "30": {"class_type": "Trellis2ShapeStage", "inputs": {"positive": ["11", 0], "negative": ["11", 1], "voxel": ["25", 0]}},
  "31": {"class_type": "CFGOverride", "inputs": {"model": ["12", 0], "cfg": 1.0, "start_percent": 0.769, "end_percent": 1.0}},
  "32": {"class_type": "RescaleCFG", "inputs": {"model": ["31", 0], "multiplier": 0.5}},
  "33": {"class_type": "KSampler", "_meta": {"title": "shape 512"},
         "inputs": {"model": ["32", 0], "positive": ["30", 0], "negative": ["30", 1], "latent_image": ["30", 2],
                    "seed": "{{seed}}", "steps": 20, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0}},
  "34": {"class_type": "Trellis2UpsampleStage",
         "inputs": {"positive": ["30", 0], "negative": ["30", 1], "shape_latent": ["33", 0], "vae": ["13", 0],
                    "target_resolution": "{{shape_resolution}}"}},
  "35": {"class_type": "KSampler", "_meta": {"title": "shape upsampled"},
         "inputs": {"model": ["32", 0], "positive": ["34", 0], "negative": ["34", 1], "latent_image": ["34", 2],
                    "seed": "{{seed}}", "steps": 12, "cfg": 7.5, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "36": {"class_type": "VaeDecodeShapeTrellis", "inputs": {"samples": ["35", 0], "vae": ["13", 0]}},

  "40": {"class_type": "Trellis2TextureStage", "inputs": {"positive": ["34", 0], "negative": ["34", 1], "shape_latent": ["35", 0]}},
  "41": {"class_type": "KSampler", "_meta": {"title": "texture"},
         "inputs": {"model": ["12", 0], "positive": ["40", 0], "negative": ["40", 1], "latent_image": ["40", 2],
                    "seed": "{{seed}}", "steps": 12, "cfg": 1.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0}},
  "42": {"class_type": "VaeDecodeTextureTrellis", "inputs": {"samples": ["41", 0], "vae": ["14", 0], "shape_subdivides": ["36", 1]}},

  "50": {"class_type": "RemeshMesh", "_meta": {"title": "watertight high-poly"},
         "inputs": {"mesh": ["36", 0], "resolution": 768, "sign_mode": "solid", "sign_mode.fill": 20.0, "sign_mode.qef": false,
                    "band": 1.0, "project_back": 0.0, "fix_poles": false, "smooth_iters": 20,
                    "drop_small_components": 0.01, "precluster_max_verts": 20000000}},
  "51": {"class_type": "DecimateMesh", "_meta": {"title": "game mesh"},
         "inputs": {"mesh": ["50", 0], "target_face_count": "{{tris}}", "placement_mode": "qem",
                    "placement_mode.line_quadric_weight": 0.0, "placement_mode.feature_edge_quadric_weight": 0.0,
                    "placement_mode.feature_edge_min_dihedral_deg": 30.0, "placement_mode.clamp_v_to_edge": true}},
  "52": {"class_type": "MeshSmoothNormals", "inputs": {"mesh": ["51", 0], "crease_angle": 180.0}},
  "53": {"class_type": "UnwrapMesh", "inputs": {"mesh": ["52", 0], "segmenter": "pec", "resolution": "{{texture_size}}",
                                                "padding": 4, "weld_distance": 0.0002}},
  "54": {"class_type": "BakeTextureFromVoxel",
         "inputs": {"mesh": ["53", 0], "voxel_colors": ["42", 0], "texture_size": "{{texture_size}}", "reference_mesh": ["36", 0]}},
  "55": {"class_type": "BakeNormalMapFromMesh",
         "inputs": {"low_poly": ["53", 0], "high_poly": ["50", 0], "resolution": "{{texture_size}}", "cage_distance": 0.05,
                    "ignore_backfaces": true}},
  "56": {"class_type": "BakeAmbientOcclusion",
         "inputs": {"low_poly": ["53", 0], "high_poly": ["50", 0], "resolution": 1024, "samples": 64, "max_distance": 0.1,
                    "strength": 1.0, "bias": 0.01}},
  "57": {"class_type": "ApplyTextureToMesh",
         "inputs": {"mesh": ["53", 0], "base_color": ["54", 0], "metallic": ["54", 1], "roughness": ["54", 2],
                    "occlusion": ["56", 0], "normal_map": ["55", 0]}},
  "58": {"class_type": "SaveGLB", "inputs": {"mesh": ["57", 0], "filename_prefix": "{{prefix_game}}"}},
  "59": {"class_type": "SaveGLB", "inputs": {"mesh": ["50", 0], "filename_prefix": "{{prefix_high}}"}}
}
